# Neon PostgreSQL database (replace with your real connection string)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Cerebras API key (https://cloud.cerebras.ai) - enables real AI analysis.
# If left empty, AI Wrapped falls back to a built-in local analyzer.
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama-3.3-70b"

# Admin dashboard password (single admin)
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET="please-change-me-32-chars-minimum"

# Public base URL of the app (used for share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
