# Neon PostgreSQL database (replace with your real connection string)
# Pooled connection recommended for Next.js: add &pgbouncer=true
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# LLM provider - Groq (recommended, free tier): https://console.groq.com/keys
# If left empty, AI Wrapped falls back to a built-in local analyzer.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional OpenAI fallback (used only if GROQ_API_KEY is empty)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Admin dashboard password (single admin)
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET="please-change-me-32-chars-minimum"

# Public base URL of the app (used for share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"