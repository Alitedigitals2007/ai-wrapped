generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id           String   @id @default(cuid())
  username     String
  aiUsed       String
  prompt       String
  response     String
  analysisJson Json
  wrappedJson  Json?
  code         String?  @unique
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([username])
  @@index([aiUsed])
  @@index([createdAt])
  @@map("submissions")
}
