generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id           String   @id @default(cuid())
  username     String
  aiUsed       String
  prompt       String
  response     String
  analysisJson Json
  wrappedJson  Json?
  code         String?  @unique
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([username])
  @@index([aiUsed])
  @@index([createdAt])
  @@map("submissions")
}

model Assessment {
  id          String    @id @default(cuid())
  name        String
  answersJson Json
  scoresJson  Json
  reportJson  Json?
  code        String?   @unique
  engine      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([name])
  @@index([createdAt])
  @@map("assessments")
}

model FriendQuiz {
  id           String        @id @default(cuid())
  creatorName  String
  title        String        @default("Who knows me best?")
  questionsJson Json
  code         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  attempts     QuizAttempt[]

  @@index([createdAt])
  @@map("friend_quizzes")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  playerName  String
  answersJson Json
  score       Int
  total       Int
  createdAt   DateTime  @default(now()) @map("created_at")

  quiz FriendQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([createdAt])
  @@map("quiz_attempts")
}
